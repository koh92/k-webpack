extends include/_layout

block variables
	- var title = 'Prosensor | Articles'

block block_breadcrumbs
	+breadcrumbs('Журнал', 'Журнал')

include components/_articles-item

block content
	.container
		.articles-page
			.articles-page__subtitle.margin-left Хотите узнать, как правильно подобрать запчасти, научиться ориентироваться в производителях и понять, как лучше действовать при появлении проблем с оборудованием?
			.articles-page__grid
				- var articles = {1:'Цифровой усилитель Haehne DA', 2:'Устройство контроля скорости Camlogic SMD20', 3:'Терминология',4:'Profibus интерфейс',5:'Цифровой усилитель Haehne DA',6:'Мембранные датчики уровня Mollet'}
					each name, key in articles
						.swiper-slide
							+articles-item(name, key)


	section.selection-form
		.container
			.selection-form__title.margin-left Не нашли нужную запчасть?
			.selection-form__subtitle.margin-left Оставьте заявку и мы подберём то, что нужно!
			.selection-form__text.margin-left Наша фирма уделяет большое внимание работе со своими клиентами и партнёрами, поэтому если у вас есть какие‑либо вопросы или предложения, мы всегда будем рады общению.
			.form.margin-left
				include components/_static-form