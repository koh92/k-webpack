extends include/_layout

block variables
	- var title = 'Delivery | Get turbo'
	- var breadcrumbs = true

block block_breadcrumbs
	+breabcrumbs('Доставка и склад', 'Доставка и склад')
 
block content
	.container
		.standart_page
			.standart_page__left
				.cms-content.cms-content--small-padding.cms-content--full-width
					p Доставка по РФ осуществляется транспортными компаниями, мы сотрудничаем только с проверенными и хорошо зарекомендовавшими себя грузоперевозчиками. При выборе данного способа доставки вы можете не беспокоится за сохранность груза, страхование включено в стоимость перевозки, вы сможете отслеживать движение груза через трекинг-систему на сайте транспортной компании.
					p Наш отдел логистики рекомендует обращаться в следующие транспортные компании: <span style="color: var(--green-color)"><b>Деловые линии, Пэк, Мажор экспресс, Яндекс Курьер</b></span>, а также Достависта (если необходима быстрая внутренняя доставка по городу)
					p <b>Доставка пешим курьером</b>: Стоимость - 500 руб. Вес - до 10 кг (кроме рулевых реек) В пределах МКАД Оплата при получении
					p <b>Доставка водителем-курьером:</b> Стоимость - 1000 руб. Вес - от 10 кг (а также рулевые рейки) В пределах МКАД Оплата при получении
					p <b>Доставка грузоперевозчиком:</b> Вес - любой Грузоперевозчик на выбор По России Оплата при получении
					p <b>Самовывоз со склада в Москве / Санкт-Петербурге</b> <a href="contacts.html">(показать на карте)</a>: ПН-ВС с 9.00 до 21.00 показать на карте Оплата при получении
			.standart_page__right
				include ./components/_static-form
				+static-form('Возникли вопросы?', 'Оставьте свои контактные данные, мы перезвоним вам')
