mixin example-item(name, image, isLight = false)
    if name === ''
        - var name = 'Название элемента'
    if image === ''
        - var image = Math.floor(Math.random() * (1 - 9) + 9)
    if isLight
        - var type = 'light'
    else
        - var type = 'dark'

    - var isBoolean = Math.floor(Math.random() * 2)
    //- if isBoolean === 0
    //- if isBoolean === 1
    
    .example__item(data-type=type)
        a.example__item-image(href="javascript:void(0)")
            +img(`Images/CMS/hero_image.jpg`, '')
            //- +img(`Images/CMS/example_item_${image}.jpg`, '')
        .example__item-box
            a.example__item-name(href="javascript:void(0)")= name
            .example__item-desc Описание
            a.btn.btn--primary.example__item-btn(data-fancybox, data-type="ajax", data-src="ajax.html", data-filter="#popup-request",data-product=name) Заказать