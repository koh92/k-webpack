					li © 2023
					li
						a(href='#') Правовая информация
					li
						a(href='#') Политика обработки персональных данных
					li
						a(href='#') Договор оферты
					
				ul.footer__socials
					li.footer__social
						a(href="#")
							+img('Images/icon_youtbe.svg', 'Youtube')
					li.footer__social
						a(href="#")
							+img('Images/icon_telegram.svg', 'Telegram')
					li.footer__social
						a(href="#")
							+img('Images/icon_vk.svg', 'VK')
					li.footer__social
						a(href="#")
							+img('Images/icon_whatsapp.svg', 'WhatsApp')