block footer
	footer.footer
		.container
			.footer__grid
				a.footer__logo(href= isProd ? "index.html" : "/")
					+img("Images/logo_white.svg", "logo")
				ul.footer__menu
					li
						a(href="404.html") 404
					li
						a(href="faq.html") FAQ
					li
						a(href="contacts.html") Контакты
				.footer__address 117105, г. Москва,<br>Тверская, 37 А
				.footer__contacts
					a.footer__contact(href='tel:89991112233') 8 (999) 111-22-33 (Москва МО)
					a.footer__contact(href='tel:88001112233') 8 (800) 111-22-33 (РФ)
				.footer__subscribe
					.footer__subscribe-title Подписывайтесь и узнавайте<br> первым обо всех акциях и новостях
					.footer__subscribe-form
						form
							input(type='email', placeholder='email')
							button.btn.btn--green Подписаться
