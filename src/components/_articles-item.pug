mixin articles-item(name, image)
    if name === ''
        - var name = 'Название статьи'
    if image === ''
        - var image = Math.floor(Math.random() * (1 - 6) + 6)
    
    .blog__item
        a.blog__item-image(href="articles-element.html")
            +img(`Images/CMS/blog_item_${image}.jpg`, name)
        a.blog__item-title(href="articles-element.html")= name
        .blog__item-desc Цифровой усилитель с выходными сигналами: Profinet, EtherNet/IP, Profibus, EtherCAT
        .blog__item-date 28.09.2020