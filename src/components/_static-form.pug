mixin static-form(title, subtitle)
    .form.form--decorate.form--static
        .form__title= title
        .form__text= subtitle
        form
            .form__input
                input(type="text", placeholder="Ваше имя")
            .form__input
                input(type="email", placeholder="E-mail")
            .form__input
                input(type="tel", placeholder="+7 (999) 999-99-99")
            input.btn.btn--green.form__btn(type="submit", value="Оставить заявку на обратный звонок")
            .form__accept Оставляя заявку вы даете согласие на обработку персональных данных согласно Политике конфиденциальности