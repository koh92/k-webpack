.custom-tabs.js-tabs
    .custom-tabs__controls
        each tab, index in exampleCustomTabsData
            button.custom-tabs__control.js-tabs-control(
                class=(index === 0 ? "active" : "")
                data-target=tab.tabID
                type="button"
            )= tab.tabName
    .custom-tabs__list
        each tab, index in exampleCustomTabsData
            .custom-tabs__element.js-tabs-element(
                class=(index === 0 ? "active" : "")
                data-target=tab.tabID
            )
            each item in exampleCustomTabsData.items 
                h3= item.name