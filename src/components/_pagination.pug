.pagination
    a.pagination__arrow.pagination__arrow--left.pagination__arrow--disabled(href="javascript:void(0)")
        +img("Images/icon_arrow_forward.svg", "Arrow icon")
    .pagination__items
        a.pagination__item.pagination__item--active(href="javascript:void(0)") 1
        a.pagination__item(href="javascript:void(0)") 2
        a.pagination__item(href="javascript:void(0)") 3
        span.pagination__item ...
        a.pagination__item(href="javascript:void(0)") 12
    a.pagination__arrow.pagination__arrow--right(href="javascript:void(0)")
        +img("Images/icon_arrow_forward.svg", "Arrow icon")