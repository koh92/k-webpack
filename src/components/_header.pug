block header
	header.js-header(data-state="closed")
		.backdrop.js-backdrop
		.container
			.header
				.header__subtitle Официальный поставщик BAUMULLER в России
				a.header__logo(href= isProd ? "index.html" : "/")
					+img("Images/logo_full.png", "logo")
				nav.header__menu
					button.header__menu-trigger.js-menu-trigger
						include Images/icon_close.svg
					ul.header__menu-list.js-header-nav-menu#primary-navigation
						li.header__menu-item
							a(href="catalog-section.html") Каталог категория
						li.header__menu-item
							a(href="catalog-element.html") Каталог элемент
						li.header__menu-item
							a(href="404.html") 404
						li.header__menu-item
							a(href="contacts.html") Контакты
				.header__search
					//-https://wp-kama.ru/function/get_search_form
					button.header__search-trigger.js-search-trigger
						include Images/icon_search.svg
					.header__search-popup
						.container
							.header__search-box
								form(role="search", method="get", action="/")
									input(type="submit", value="")
									input(type="search", placeholder="Что хотите найти?", name="s")
								button.header__search-trigger.js-search-trigger
									include Images/icon_close.svg
				.header__contacts
					.header__contact.header__contact--blue
						a(href="tel:+74956428476") +7 495 642-84-76
					.header__contact.header__contact--black
						a(href="mailto:info@prosensor.ru") info@prosensor.ru
				.header__burger.js-menu-trigger
					button.menu-toggle(
						aria-label="Menu"
						aria-controls="primary-navigation"
						aria-expanded="false"
					)
						span.visually-hidden Menu
						.k_burger(aria-hidden="true")
				