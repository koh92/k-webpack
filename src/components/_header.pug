				.header__btn
					a.btn.btn--white.btn--download(data-fancybox, data-src="#presentation-popup") Получить презентацию
				.header__callback
					a.btn.btn--white.btn--callback(data-fancybox, data-src="#callback-popup") Заказать звонок
				.header__burger
					button.menu-toggle(
						aria-label="Menu"
						aria-controls="primary-navigation"
						aria-expanded="false")
						span.visually-hidden Menu
						.k_burger(aria-hidden="true")
				nav.header__menu
					ul.header__menu-list.js-header-nav-menu#primary-navigation
						li.header__menu-item.header__menu-item--underline
							a.js-anchor(href="https://azpo.ru/") Перейти на основной сайт
						li.header__menu-item
							a.js-anchor(href="#aboutProject") О проекте
						li.header__menu-item
							a.js-anchor(href="#flats") Квартиры
						li.header__menu-item
							a.js-anchor(href="#aboutCompany") О нас
						li.header__menu-item
							a.js-anchor(href="#contact") Контакты
