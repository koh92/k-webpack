						.header__action-text Профиль
				.header__catalog
					a.btn.btn--green.header__catalog-btn(href= "catalog.html") Каталог
				nav.header__menu
					ul.header__menu-list.js-header-nav-menu#primary-navigation
						li.header__menu-item
							a(href= "about.html") О компании
						li.header__menu-item.header__menu-item--has-submenu
							a(href= "clients.html") Клиентам
							ul.header__submenu
								li.header__submenu-item
									a(href="info.html") Информационные материалы
								li.header__submenu-item
									a(href="partnership.html") Сотрудничество
								li.header__submenu-item
									a(href="delivery.html") Доставка и склад
								li.header__submenu-item
									a(href="payment.html") Способы оплаты
								li.header__submenu-item
									a(href="guarantee.html") Гарантии и возврат
						li.header__menu-item
							a(href= "partnership.html") Сотрудничество
						li.header__menu-item
							a(href= "contacts.html") Контакты
				a.header__phone(href="tel:+78004554511")
					.header__phone-icon <svg viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#a)"><path d="M5.153.77A1.246 1.246 0 0 0 3.672.043l-2.75.75C.378.944 0 1.438 0 2.001c0 7.73 6.269 14 14 14 .563 0 1.056-.378 1.206-.922l.75-2.75a1.246 1.246 0 0 0-.725-1.481l-3-1.25a1.246 1.246 0 0 0-1.447.362L9.522 11.5A10.562 10.562 0 0 1 4.5 6.48l1.54-1.26c.429-.35.576-.937.363-1.446l-1.25-3V.769z"/></g><defs><clipPath id="a"><path fill="#fff" d="M0 0h16v16H0z"/></clipPath></defs></svg>
					.header__phone-value 8 (800) 455-45-11
				.header__schedule
