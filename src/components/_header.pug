					.header__schedule-text Ежедневно: 
					.header__schedule-time 10:00–22:00
				.header__btn
					a.btn.btn--white(data-fancybox, data-src="#callback-popup") Заказать звонок
				.header__burger
					button.menu-toggle(
						aria-label="Menu"
						aria-controls="primary-navigation"
						aria-expanded="false")
						span.visually-hidden Menu
						.k_burger(aria-hidden="true")
				.header__hr