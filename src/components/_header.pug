block header
	header.js-header(data-state="closed")
		.container
			.header
				a.header__logo(href= isProd ? "index.html" : "/")
					+img("Images/logo.svg", "Get Turbo")
				.header__search
					form(action="search.html")
						input(type="search", name="q", placeholder="Поиск", autocomplete="off")
						button(name="s", type="submit") <svg viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.152 17.032a7.886 7.886 0 1 0 0-15.773 7.886 7.886 0 0 0 0 15.773v0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m18.785 18.786-3.973-3.973" stroke="#07422E" stroke-width="2" stroke-linejoin="round"/></svg>
				a.header__help(data-fancybox, data-src="#help-popup")
					span Не знаете номер турбины?&nbsp;
					span Мы можем помочь с подбором!
				.header__actions 
					a.header__action(href= "basket.html")
