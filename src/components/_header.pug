block header
	header.js-header(data-state="closed")
		.container
			.header
				a.header__logo(href= isProd ? "index.html" : "/")
					+img("Images/logo_black.svg", "logo")
				.header__search
					//-https://wp-kama.ru/function/get_search_form
					form(role="search", method="get", action="/")
						input(type="search", placeholder="Поиск товаров...", name="s")
						input(type="submit", value="")
				.header__contacts
					.header__contact
						a.header__contact-value(href="89991112233") 8 (999) 111-22-33
						.header__contact-note (Москва МО)
					.header__contact
						a.header__contact-value(href="88001112233") 8 (800) 111-22-33
						.header__contact-note (РФ)
				.header__icons.header__icons--pc
					a.header__icon.header__icon--mobile-hide(href="#")
						.header__icon-img(data-counter="8")
							include Images/icon_favorites.svg
					a.header__icon.header__icon--mobile-hide(href="#")
						.header__icon-img(data-counter="12")
							include  Images/icon_basket.svg
				.header__burger
					button.menu-toggle(
						aria-label="Menu"
						aria-controls="primary-navigation"
						aria-expanded="false"
					)
						span.visually-hidden Menu
						.k_burger(aria-hidden="true")
				nav.header__menu
					ul.header__menu-list.js-header-nav-menu#primary-navigation
						li.header__menu-item
							a(href="404.html") 404
						li.header__menu-item
							a(href="faq.html") FAQ
						li.header__menu-item
							a(href="contacts.html") Контакты
				.header__icons.header__icons--mobile
					a.header__icon(href="#")
						.header__icon-img
							include Images/icon_favorites.svg
					a.header__icon(href="#")
						.header__icon-img(data-counter="12")
							+img('Images/icon_basket_black.svg', 'Basket')
				.header__socials
					noindex
						ul.header__socials-list
							li.header__socials-item
								a(href="#")
									+img('Images/icon_youtbe.svg', 'Youtube')
							li.header__socials-item
								a(href="#")
									+img('Images/icon_telegram.svg', 'Telegram')
							li.header__socials-item
								a(href="#")
									+img('Images/icon_vk.svg', 'VK')
							li.header__socials-item
								a(href="#")
									+img('Images/icon_whatsapp.svg', 'WhatsApp')
				.header__login
					a.btn.btn--green(data-fancybox, data-src="#auth") Салонам