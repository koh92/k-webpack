mixin news-item(name, image, isLight = false)
    if name === ''
        - var name = 'Название элемента'
    
    .news__item
        a.news__item-image(href="news-detail.html")
            +img(`Images/CMS/hero_image.jpg`, '')
        .news__item-box
            a.news__item-name(href="news-detail.html")= name
            .news__item-desc Превью текст, который содержит описание новости
            a.btn.btn--primary.news__item-btn(href="news-detail.html") Подробнее