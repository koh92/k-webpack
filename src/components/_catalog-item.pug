mixin catalog-item(name, image, isLight = false)
    if name === ''
        - var name = 'Название продукта'
    if image === ''
        - var image = Math.floor(Math.random() * (1 - 9) + 9)
    if isLight
        - var type = 'light'
    else
        - var type = 'dark'
    
    .catalog__item(data-type=type)
        a.catalog__item-image(href="catalog-element.html")
            +img(`Images/CMS/catalog_item_${image}.jpg`, name)
        .catalog__item-box
            a.catalog__item-name(href="catalog-element.html")= name
            .catalog__item-desc Цифровой усилитель с выходными сигналами: Profinet, EtherNet/IP, Profibus, EtherCAT
            a.btn.btn--orange.catalog__item-btn(data-fancybox, data-src="#popup-request",data-product=name) Заказать