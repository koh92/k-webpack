extends include/_layout

block variables
	- var title = 'Project name | News'
	- var breadcrumbs = true

include components/_news-item

block block_breadcrumbs
	+breadcrumbs('Новости', 'Новости')

block content
	section.news
		.container 
			.news__list
				-
					var newsItems = [
						{name: 'Название первой новости'},
						{name: 'Название второй новости'},
						{name: 'Название третей новости'},
					]
				each newsItem, index in newsItems
					+news-item(newsItem.name, index)
				