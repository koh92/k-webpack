extends include/_layout

block variables
	- var title = "Project name | News"
	- var isPageHeading = true

include components/_item-example

block block_page-heading
	+page-heading("Новости", {"url": "news", "name": "Новости"})

block content
	section.news
		.container 
			.news__list
				each item, index in exampleNewsData
					+item-example({name: item.name, image: index})
				