doctype html
html(lang="ru")
	//- Available variables
	//- var title - set Page title
	//- vat yandexMap - add JS for Yandex Map
	//- var swiper - add CSS for Swiper
	//- var fancybox - add CSS for Fancybox
	//- var wow - add CSS for Wow js
	block variables
		//- - var fancybox = false
		//- - var yandexMap = false
		//- - var swiper = false
		//- - var wow = false

	include _mixins

	head
		meta(charset="UTF-8")
		meta(http-equiv="X-UA-Compatible", content="IE=edge")
		meta(name="viewport", content="width=device-width, initial-scale=1.0")

		title= title || 'Page title here'

		// CSS::Start
		include _css
		// CSS::End

	body
		// Header::Start
		include ../components/_header


		if breadcrumbs === true
			// Breadcrumbs::Start
			include ../components/_breadcrumbs
			block block_breadcrumbs
			// Breadcrumbs::End

		// Header::End

		// Main::Start
		main
			block content
		// Main::End

		// Footer::Start
		include ../components/_footer
		// Footer::End

		// Popup::Start
		include ../components/_popup
		// Popup::End

		// JavaScript::Start
		include _js
		// JavaScript::End