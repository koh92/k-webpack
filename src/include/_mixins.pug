mixin img(path, name)
	img(src= require(path), alt= name, title= name)

mixin source(path, mediaQuery)
	source(srcset= require(path), media= `(min-width: ${mediaQuery})`)

mixin video(path)
	video(
		playsinline,
		muted,
		autoplay,
		loop,
		poster!= attributes.poster
		)
		source(src= path, type!=attributes.type || "video/mp4")