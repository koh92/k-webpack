extends include/_layout

block variables
	- var title = 'Catalog Element | Get turbo'
	- var breadcrumbs = true
	- var swiper = true

block block_breadcrumbs
	+breabcrumbs('Турбокомпрессор МТА 1501', 'Каталог', 'Турбокомпрессоры', 'Турбокомпрессор МТА 1501')

include components/_catalog-item

