extends include/_layout

block variables
	- var title = 'Favourite | Get turbo'
	- var breadcrumbs = true

block block_breadcrumbs
	+breabcrumbs('Избранное', 'Избранное')

include components/_catalog-item

block content
	.container
		.catalog
			.catalog__grid.catalog__grid--one-column-mobile
				- var favCount = Math.floor(Math.random() * (1 - 8) + 8)
				- for (var i = 0; i < favCount; ++i)
					+catalog-item()