extends include/_layout

block variables
	- var title = 'Prosensor | About'

block block_breadcrumbs
	+breadcrumbs('О компании', 'О компании')

block content
	.container
		.about.margin-left
			.about__subtitle У нас в приоритете тщательное изучение потребностей наших заказчиков и удовлетворение их с учётом современного уровня развития техники и производства.
			.about__info
				.about__image
					+img('Images/CMS/about-baumuller.png', 'Baumuller')
				.about__text
					p Наша компания занимается поставками средств автоматизации из Европы с 2007 г. За это время реализовано большое количество проектов по автоматизации различных производств помимо поставки продукции для поддержания работоспособности производственных линий. В нынешних непростых условиях благодаря нескольким каналам параллельного импорта поставки продолжаются. 
					p Также благодаря опыту, накопленному в качестве дистрибьютора и сервисного партнёра компании «Baumueller» осуществляем сервисное обслуживание, ремонт и модернизацию приводной техники в различных областях индустрии.
		.about__advantages
			.about__advantages-title.margin-left Факты о нас
			.advantages__grid
				.advantages__item
					.advantages__item-title 17 лет на рынке
				.advantages__item 
					.advantages__item-title Доставка<br>по всей России
				.advantages__item.advantages__item--span
					.advantages__item-title Более 5000 <br>довольных клиентов
					.advantages__item-image
						+img('Images/CMS/about-advantages-1.jpg', 'Более 5000 довольных клиентов')
				.advantages__item.advantages__item--span
					.advantages__item-title Оригинальная продукция
					.advantages__item-image
						+img('Images/CMS/about-advantages-2.jpg', 'Оригинальная продукция')


	section.manufacturers-section
		.container
			.page-subtitle.margin-left Сотрудничаем<br>с ведущими производителями
			.marquee(style="--marquee-duration: 30s")
				- var manufacturer = {1:'Belden', 2:'TE', 3:'Евраз', 4:'Готэк',5:'ТМК',6:'Segezha',7:'ОМК',8:'MKM',9:'Baluff'}
				.marquee__group
					each name, key in manufacturer
						a.marquee__item.noselect(href="partner.html")
							+img(`Images/CMS/partner_${key}.jpg`, name)
				.marquee__group(aria-hidden="true")
					each name, key in manufacturer
						a.marquee__item.noselect(href="partner.html")
							+img(`Images/CMS/partner_${key}.jpg`, name)
			a.btn.btn--transparent.margin-left(href="manufacturers.html") Все производители
	section.selection-form
		.container
			.selection-form__title.margin-left Не нашли нужную запчасть?
			.selection-form__subtitle.margin-left Оставьте заявку и мы подберём то, что нужно!
			.selection-form__text.margin-left Наша фирма уделяет большое внимание работе со своими клиентами и партнёрами, поэтому если у вас есть какие‑либо вопросы или предложения, мы всегда будем рады общению.
			.form.margin-left
				include components/_static-form