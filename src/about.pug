extends include/_layout

block variables
	- var title = 'About | Get turbo'
	- var breadcrumbs = true

block block_breadcrumbs
	+breabcrumbs('О компании', 'О компании')

block content
	.container
		.about__section
			.about__seo
				.about__seo-text 
					p «GETTURBO» — крупнейший поставщик автотракторного электрооборудования в России и странах СНГ. Мы продаем оптом изделия 200 профильных заводов России и Белоруссии. С отдельными производителями сотрудничаем на правах дилера и эксклюзивного представителя. 
					p У нас вы найдёте все необходимые запчасти на тракторы, грузовики и легковые машины отечественного производства (МТЗ, ХТЗ, КАМАЗ, МАЗ, ЛИАЗ, ГАЗ, ВАЗ).
					p Компания начала свой путь на рынке в 1993-м, когда гиганты автопрома простаивали без заказов и старые цепочки поставок были прерваны. Мы одними из первых начали сотрудничать с заводами напрямую, обеспечив рынок сбыта в новых реалиях страны. 
					p Миссия, которой удаётся соответствовать многие годы, — стабильность и  индивидуальный подход к каждому клиенту. Сегодня их более 800.
					p Миссия, которой удаётся соответствовать многие годы, — стабильность и  индивидуальный подход к каждому клиенту. Сегодня их более 800.
					p Компания начала свой путь на рынке в 1993-м, когда гиганты автопрома простаивали без заказов и старые цепочки поставок были прерваны. Мы одними из первых начали сотрудничать с заводами напрямую, обеспечив рынок сбыта в новых реалиях страны. 
				.about__seo-image
					+img('Images/CMS/about-image.jpeg', '«GETTURBO» — крупнейший поставщик автотракторного электрооборудования в России и странах СНГ')
		.about__section
			.about__title Наши преимущества
			.about__grid
				.about__ceil
					.about__testimonials
						.about__testimonial
							.about__testimonial-icon
								+img('Images/icon_benefit_card_1.svg', 'Товаров в нашем каталоге')
							.about__testimonial-number 2 000 +
							.about__testimonial-title Товаров в нашем каталоге
							.about__testimonial-text Мы предлагаем более 15000 наименований запчастей на все виды автотранспортных средств, тракторную и сельхозтехнику, спецтехнику.
						.about__testimonial
							.about__testimonial-icon
								+img('Images/icon_benefit_card_2.svg', 'Работы на рынке')
							.about__testimonial-number 6 лет
							.about__testimonial-title Работы на рынке
							.about__testimonial-text Большой опыт работы, в том числе с ведущими компаниями России. Мы сотрудничаем с крупнейшими поставщиками, только профессиональное оборудование.
						.about__testimonial
							.about__testimonial-icon
								+img('Images/icon_benefit_card_3.svg', 'Срочная доставка')
							.about__testimonial-number Экспресс
							.about__testimonial-title Срочная доставка
							.about__testimonial-text Экспресс-доставка в течение 2-3 часов в Москве / Санкт-Петербурге, доставка по всей России. Работаем со всеми самыми популярными сервисами доставки!
						.about__testimonial
							.about__testimonial-icon
								+img('Images/icon_benefit_card_4.svg', 'Гарантия')
							.about__testimonial-number 12 мес.
							.about__testimonial-title Гарантия
							.about__testimonial-text На весь ассортимент мы предоставляем гарантию до 3 лет! Возврат, замена и ремонт по гарантии сроком на 12 месяцев.Гарантийное обслуживание. Сервис.
				.about__ceil
