extends include/_layout

block variables
	- var title = 'Prosensor | Manufacturers'

block block_breadcrumbs
	+breadcrumbs('Производители', 'Производители')

block content
	.container
		.manufacturers-page
			.manufacturers-page__grid
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_1.jpg', 'AS-Schneider')
					.manufacturers__item-name AS-Schneider
					.manufacturers__item-description Компания является одним из ведущих в мире производителей инструментальных вентилей и вентильных блоков.
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_2.jpg', 'Baumueller Nurnberg GmbH')
					.manufacturers__item-name Baumueller Nurnberg GmbH
					.manufacturers__item-description Мировой лидер в разработке, конструировании и изготовлении оптимизированных систем приводов.
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_3.jpg', 'BERNSTEIN')
					.manufacturers__item-name BERNSTEIN
					.manufacturers__item-description Цифровой усилитель с выходными сигналами: Profinet, EtherNet/IP, Profibus, EtherCAT
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_4.jpg', 'VEGA')
					.manufacturers__item-name VEGA
					.manufacturers__item-description Мировой производитель промышленных приборов для измерения уровня, предельного уровня, давления, а также устройств и программного обеспечения для интеграции в системы управления технологическими процессами.
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_5.jpg', 'BALUFF')
					.manufacturers__item-name BALUFF
					.manufacturers__item-description Лидер в области производства датчиков и компонентов автоматики
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_6.jpg', 'Schrack Technik')
					.manufacturers__item-name Schrack Technik
					.manufacturers__item-description Одно из ведущих предприятий в области производства инновационных продуктов электротехники.
				a.manufacturers__item(href="manufacturers-element.html")
					.manufacturers__item-image
						+img('Images/CMS/manufacturers_7.jpg', 'EGE Elektronik')
					.manufacturers__item-name EGE Elektronik
					.manufacturers__item-description Компания занимается разработкой и производством датчиков специального назначения для систем автоматизации
