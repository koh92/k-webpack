extends include/_layout

block variables
	- var title = "Project name | Contacts"
	- var bodyClass = "page-contacts"
	- var yandexMap = true
	- var isPageHeading = true

block block_page-heading
	+page-heading("Контакты", {"name": "Контакты"})

block content
	.contacts
		.container
			.contacts__grid
				.contacts__subtitle Ответим на все вопросы и подберём решение для вашей задачи
				.contacts__list
					.contacts__item
						.contacts__item-title Телефон
						.contacts__item-value
							a(href="+74957777777") +7 495 777-77-77
					.contacts__item
						.contacts__item-title Факс
						.contacts__item-value +7 495 777-77-77
					.contacts__item
						.contacts__item-title E-mail:
						.contacts__item-value 
							a(href="mailto:email@email.ru") email@email.ru 
					.contacts__item
						.contacts__item-title Адрес
						.contacts__item-value г. Москва
				.form
					include components/_form-static
		.container
			.contacts__map.js-contacts-map
				.contacts__map-coord
					.js-contacts-map-coord(data-coord="55.754009, 37.620324", data-hint="Офис")
				.contacts__map-area#js-contacts-map