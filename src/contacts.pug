extends include/_layout

block variables
	- var title = 'Project name | Contacts'
	- var yandexMap = true

block block_breadcrumbs
	+breadcrumbs('Контакты', 'Контакты')

block content
	.contacts
		.container
			.contacts__list
				.contacts__item
					.contacts__item-title Адрес офиса:
					.contacts__item-value 117105, г. Москва, Варшавское ш., 37 А
				.contacts__item
					.contacts__item-title E-mail:
					.contacts__item-value 
						a(href="mailto:info@test.ru") info@test.ru 
				.contacts__item
					.contacts__item-title Телефон:
					.contacts__item-value 
						.contacts__item-row
							a(href="tel:89991112233") 8 (999) 111-22-33 (Москва МО) 
						.contacts__item-row
							a(href="tel:88001112233") 8 (800) 111-22-33 (РФ)
				.contacts__item
					.contacts__item-title Время работы:
					.contacts__item-value
						.contacts__item-row Пн - Пт 10:00 - 18:00 
						.contacts__item-row Сб - Вс выходной
			.contacts__map.js-contacts-map
				.contacts__map-coord
					.js-contacts-map-coord(data-coord="55.689040, 37.624534", data-hint="Офис")
					.js-contacts-map-coord(data-coord="55.820069, 37.621044", data-hint="Склад")
				.contacts__map-area#js-contacts-map