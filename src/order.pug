extends include/_layout

block variables
	- var title = 'Order | Get turbo'
	- var breadcrumbs = true

block block_breadcrumbs
	+breabcrumbs('Оформление заказа', 'Корзина', 'Оформление заказа')

block content
	.container
		.order
			.order__main
				.order__section
					.gt-table.gt-table--order
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil 1. Товары в заказе
						.gt-table__row
							.gt-table__ceil Артикул
							.gt-table__ceil Наименование
							.gt-table__ceil Кол-во
							.gt-table__ceil Цена
						- for (var i = 0; i < 10; ++i)
							.gt-table__row
								.gt-table__ceil А422555
								.gt-table__ceil MAHLE 639TC15298000
								.gt-table__ceil 22 шт.
								.gt-table__ceil 122 420 ₽
					.order__coupon.gt-table__fake-ceil
						.order__subtitle Применить купон:
						.order__coupon-inputs
							.order__coupon-input.order__input
								input(type="text", placeholder="Номер купона")
							.order__coupon-btn
								button.btn.btn--grey Применить
									
					.gt-table.gt-table--aside.gt-table--mobile
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil Товаров на:
							.gt-table__ceil 1 224 200 ₽
						.gt-table__row
							.gt-table__ceil Доставка:
							.gt-table__ceil 500 ₽
						.gt-table__row
							.gt-table__ceil Итого:
							.gt-table__ceil 1 224 700 ₽
					.order__route.gt-table__fake-ceil
						button.btn.btn--green Далее
				.order__section
					.gt-table
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil 2. Регион доставки
					.gt-table__fake-ceil
						.order__subsection
							.order__buyer
								.order__subtitle Тип плательщика:
								.order__buyer-list
									.order__buyer-item
										input#radio1(type="radio", name="PERSON_TYPE")
										label(for="radio1") Физическое лицо
									.order__buyer-item
										input#radio2(type="radio", name="PERSON_TYPE")
										label(for="radio2") Юридическое лицо
						.order__subsection
							.order__location
								.order__subtitle Местоположение:
								.order__input
									input(type="text", placeholder="Москва, Центр, Россия")
						.order__subsection
							.order__zip
								.order__subtitle Индекс:
								.order__input
									input(type="text", placeholder="101000")
								.order__tip Выберите свой город в списке. Если вы не нашли свой город, выберите "другое местоположение", а город впишите в поле "Город"
					.order__route.gt-table__fake-ceil
						button.btn.btn--green-transparent Назад
						button.btn.btn--green Далее
				.order__section
					.gt-table
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil 3. Оплата
					.gt-table__fake-ceil
						.order__subsection
							.order__payment 
								.order__subtitle Выберите способ оплаты:
					.order__route.gt-table__fake-ceil
						button.btn.btn--green-transparent Назад
						button.btn.btn--green Далее
				.order__section
					.gt-table
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil 4. Доставка
					.gt-table__fake-ceil
						.order__subsection
							.order__delivery
								.order__subtitle Выберите способ доставки:
					.order__route.gt-table__fake-ceil
						button.btn.btn--green-transparent Назад
						button.btn.btn--green Далее
				.order__section
					.gt-table
						.gt-table__row.gt-table__row--heading
							.gt-table__ceil 5. Покупатель
					.gt-table__fake-ceil
						.order__subsection
							.order__customer
								.order__subsection
									.order__subtitle <span>*</span> Ф.И.О.
									.order__input
										input(type="text")
								.order__subsection
									.order__subtitle <span>*</span> E-Mail
									.order__input
										input(type="text")
								.order__subsection
									.order__subtitle <span>*</span> Телефон
									.order__input
										input(type="text")
								.order__subsection
									.order__subtitle <span>*</span> Адрес доставки
									.order__input
										input(type="text")
								.order__subsection
									.order__subtitle <span>*</span> Комментарии к заказу:
									.order__input
										textarea(rows="5")
					.order__route.gt-table__fake-ceil
						button.btn.btn--green-transparent Назад
				button.btn.btn--green Оформить заказ
				label.order__accept
					.order__accept-input
						input(type="checkbox")
					.order__accept-text Нажимая кнопку «Оформить заказ», я даю свое согласие на обработку моих персональных данных, в соответствии с Федеральным законом от 27.07.2006 года №152-ФЗ «О персональных данных», на условиях и для целей, определенных в Согласии на обработку персональных данных

			.order__aside
				.gt-table.gt-table--aside
					.gt-table__row.gt-table__row--heading
						.gt-table__ceil Товаров на:
						.gt-table__ceil 1 224 200 ₽
					.gt-table__row
						.gt-table__ceil Доставка:
						.gt-table__ceil 500 ₽
					.gt-table__row
						.gt-table__ceil Итого:
						.gt-table__ceil 1 224 700 ₽


		