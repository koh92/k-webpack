extends include/_layout

block variables
	- var title = 'Prosensor | Manufacturer'

block block_breadcrumbs
	+breadcrumbs('Bernstein', 'Производители', 'Bernstein')

block content
	.container
		.manufacturers-element
			.manufacturers-element__description.margin-left
				p Инструменты от торговой марки Bernstein (Бернштайн) — образец высокого немецкого качества. Компания занимается производством высокоточного ручного оборудования. На сегодняшний день в каталоге бренда представлен весь спектр качественных и надёжных инструментов для для всех отраслей мировой электронной промышленности.
				p В первую очередь продукция ориентирована на специалистов в индустрии электроники, однако её применение значительно шире и не ограничивается электронной техникой и ремонтными мастерскими.
				p Название компании происходит от имени и фамилии её основателя и идейного вдохновителя, Бернарда Штайнрюкке. История марки тесно связана с периодом становления радио и телевидения и насчитывает более 50 лет непрерывного развития и совершенствования продукции в сотрудничестве с ведущими телекоммуникационными центрами Германии.
				p Все инструменты изготавливаются из качественных материалов, проходят испытания качества и обязательную сертификацию на соответствие требованиям международной безопасности. Главное отличие продукции — особый изоляционный материал рукоятки, который препятствует образованию и переносу зарядов статического электричества при выполнении радиомонтажных и сборочных работ.
			noindex
				a.manufacturers-element__link.margin-left(href="#") Перейти на сайт производителя
			.manufacturers-element__related
				.manufacturers-element__related-title.margin-left Похожие производители
				.manufacturers-element__related-grid
					a.manufacturers__item(href="manufacturers-element.html")
						.manufacturers__item-image
							+img('Images/CMS/manufacturers_1.jpg', 'AS-Schneider')
						.manufacturers__item-name AS-Schneider
						.manufacturers__item-description Компания является одним из ведущих в мире производителей инструментальных вентилей и вентильных блоков.
					a.manufacturers__item(href="manufacturers-element.html")
						.manufacturers__item-image
							+img('Images/CMS/manufacturers_2.jpg', 'Baumueller Nurnberg GmbH')
						.manufacturers__item-name Baumueller Nurnberg GmbH
						.manufacturers__item-description Мировой лидер в разработке, конструировании и изготовлении оптимизированных систем приводов.
					a.manufacturers__item(href="manufacturers-element.html")
						.manufacturers__item-image
							+img('Images/CMS/manufacturers_3.jpg', 'BERNSTEIN')
						.manufacturers__item-name BERNSTEIN
						.manufacturers__item-description Цифровой усилитель с выходными сигналами: Profinet, EtherNet/IP, Profibus, EtherCAT
