extends include/_layout

block variables
	- var title = 'Project name'
	- var breadcrumbs = false

include components/_accordion

block content
	section.hero
		.container
			h1.hero__title Комплектация предприятий запасными частями
			.hero__subtitle
				.hero__subtitle-text к технологическому оборудованию
				.btn.btn--orange.hero__subtitle-btn(data-fancybox, data-src="#popup-choose") Подобрать оборудование
			.hero__image
				+img('Images/CMS/hero_image.jpg')
			.hero__advantages
				ul.hero__advantages-list
					li.hero__advantages-item
						.hero__advantages-number 17
						.hero__advantages-text лет на рынке
					li.hero__advantages-item.hero__advantages-item--top-shift
						.hero__advantages-number 3000
						.hero__advantages-text товаров в ассортименте
					li.hero__advantages-item
						.hero__advantages-number 5000
						.hero__advantages-text довольных клиентов
	//- accordion test section
	.container 123
		- var accordionList = {1:{name: 'Вопрос 1!', text: 'Lorem ipsum dolor sit amet consectetur, adipisicing elit. Repellendus, dignissimos.'}, 2:{name: 'Вопрос 2!', text: 'Lorem ipsum dolor sit amet consectetur, adipisicing elit. Repellendus, dignissimos.'}, 3:{name: 'Вопрос 3!', text: 'Lorem ipsum dolor sit amet consectetur, adipisicing elit. Repellendus, dignissimos.'}, 4:{name: 'Вопрос 4!', text: 'Lorem ipsum dolor sit amet consectetur, adipisicing elit. Repellendus, dignissimos.'} }
		+accordion-section(accordionList, 'Тестовый аккордеон')
	//- dropdown test section
	.container
		.dropdown__heading.js-dropdown-heading
			.dropdown__heading-text EUR
			.dropdown__arrow
				svg(viewBox="0 0 40 40")
					use(xlink:href="#icon_arrow_down_white")
		.dropdown__box
			.dropdown__content
				ul
					li
						a.dropdown__item.active(href="#") RUB
					li
						a.dropdown__item(href="#") TRY
					li
						a.dropdown__item(href="#") USD

	section.advantages
		.container
			.page-subtitle.margin-left Почему выбирают нас?
			.advantages__grid
				.advantages__item 
					.advantages__item-title Доставка <br>по всей России
					.advantages__item-text Оставьте заявку и в ближайшее время наши менеджеры ответят на все вопросы
				.advantages__item 
					.advantages__item-title Сервисное <br>обслуживание
					.advantages__item-text Оставьте заявку и в ближайшее время наши менеджеры ответят на все вопросы
				.advantages__item.advantages__item--span-md
					.advantages__item-title Модернизация<br>оборудования
					.advantages__item-text Наша компания предлагает услуги по модернизации промышленного оборудования. Мы заменяем устаревшие компоненты, добавляем новые функции и возможности, повышаем эффективность работы и уменьшаем затраты на эксплуатацию.
				.advantages__item.advantages__item--span
					.advantages__item-title Оригинальная продукция
					.advantages__item-text Поставка оригинальной продукции множества мировых производителей средств автоматизации ушедших с нашего рынка.
					.advantages__item-image
						+img('Images/CMS/advantages.jpg', 'Оригинальная продукция')
			a.btn.btn--transparent.margin-left(href="blog.html") Все статьи
	section.popular
		.container
			.page-subtitle.margin-left Популярные категории
			.popular__grid
				a.popular__item.popular__item--row-span(href="catalog-section.html")
					.popular__item-name Угол поворота
					.popular__item-icon.popular__item-icon--angle
						include Images/icon_angle.svg
				a.popular__item(href="catalog-section.html")
					.popular__item-name Давление
					.popular__item-icon.popular__item-icon--pressure
						include Images/icon_pressure.svg
				a.popular__item(href="catalog-section.html")
					.popular__item-name Приводная техника
					.popular__item-icon.popular__item-icon--servo
						include Images/icon_servo.svg
				a.popular__item.popular__item--column-span(href="catalog-section.html")
					.popular__item-name Линейное перемещение
					.popular__item-icon.popular__item-icon--linear
						include Images/icon_linear.svg
	//- Marquee test section
	section.clients
		.container
			.page-subtitle.margin-left Наши клиенты
			.marquee(style="--marquee-duration: 30s")
				- var clients = {1:'Belden', 2:'TE', 3:'Евраз', 4:'Готэк',5:'ТМК',6:'Segezha',7:'ОМК',8:'MKM',9:'Baluff'}
				.marquee__group
					each name, key in clients
						.marquee__item.noselect
							+img(`Images/CMS/partner_${key}.jpg`, name)
				.marquee__group(aria-hidden="true")
					each name, key in clients
						.marquee__item.noselect
							+img(`Images/CMS/partner_${key}.jpg`, name)
	section.selection-form
		.container
			.selection-form__title.margin-left Не нашли нужную запчасть?
			.selection-form__subtitle.margin-left Оставьте заявку и мы подберём то, что нужно!
			.selection-form__text.margin-left Наша фирма уделяет большое внимание работе со своими клиентами и партнёрами, поэтому если у вас есть какие‑либо вопросы или предложения, мы всегда будем рады общению.
			.form.margin-left
				include components/_static-form