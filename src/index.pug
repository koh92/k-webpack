extends include/_layout

block variables
	- var title = "Project name"

block content
	section.hero
		.container
			.hero__box
				.hero__info 
					h1.hero__title Заголовок H1
					.hero__subtitle Подзаголовок
					.btn.--primary.hero__btn(data-fancybox, data-type="ajax", data-src="ajax.html", data-filter="#popup-request") Call to action
				.hero__image
					+img("Images/example/hero_image.jpg")

	section.selection-form
		.container
			.form
				include components/_form-static