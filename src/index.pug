extends include/_layout

block variables
	- var title = 'Project name'

block content
	section.hero
		.container
			h1.hero__title Заголовок
			.hero__subtitle
				.hero__subtitle-text подзаголовок
				.btn.btn--orange.hero__subtitle-btn(data-fancybox, data-src="#popup-request") Call to action
			.hero__image
				+img('Images/CMS/hero_image.jpg')

	section.selection-form
		.container
			.form
				include components/_static-form