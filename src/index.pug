extends include/_layout

block variables
	- var title = 'Project name'
	- var breadcrumbs = false

block content
	section.hero
		.container
			//- Slider main container
			.hero__slider.js-hero-swiper
				//- Additional required wrapper
				.swiper-wrapper
					//- Slides
					.hero__slider-item.swiper-slide
						a.hero__slider-image(href="#")
							picture
								//- source(media="(min-width: 1170px)" srcset='Images/CMS/hero_slider_1_1170.jpg')
								//- source(media="(min-width: 768px)" srcset='Images/CMS/hero_slider_1_768.jpg')
								//- +img('Images/CMS/hero_slider_1_360.jpg', 'REHUB+ specialist KERATIN MULTILEVEL TECHNOLOGY')
								+img('Images/CMS/hero_slider_1.jpg', 'Alt + title')
						.hero__slider-info
							.hero__slider-title Заголовок слайда
							.hero__slider-subtitle Подзаголовок слайда
							a.btn.btn--green.hero__slider-btn(href="#") Подробнее
					.hero__slider-item.swiper-slide
						a.hero__slider-image(href="#")
							picture
								//- source(media="(min-width: 1170px)" srcset='Images/CMS/hero_slider_2_1170.jpg')
								//- source(media="(min-width: 768px)" srcset='Images/CMS/hero_slider_2_768.jpg')
								//- +img('Images/CMS/hero_slider_2_360.jpg', 'BOTANICAL 10/M')
								+img('Images/CMS/hero_slider_2.jpg', 'Alt + title')
						.hero__slider-info
							.hero__slider-title Заголовок слайда
							.hero__slider-subtitle Подзаголовок слайда
							a.btn.btn--green.hero__slider-btn(href="#") Подробнее
					.hero__slider-item.swiper-slide
						a.hero__slider-image(href="#")
							picture
								//- source(media="(min-width: 1170px)" srcset='Images/CMS/hero_slider_3_1170.jpg')
								//- source(media="(min-width: 768px)" srcset='Images/CMS/hero_slider_3_768.jpg')
								//- +img('Images/CMS/hero_slider_3_360.jpg', 'REFORCE SPECIFIC 1/L')
								+img('Images/CMS/hero_slider_3.jpg', 'Alt + title')
						.hero__slider-info
							.hero__slider-title Заголовок слайда
							.hero__slider-subtitle Подзаголовок слайда
							a.btn.btn--green.hero__slider-btn(href="#") Подробнее
					.hero__slider-item.swiper-slide
						a.hero__slider-image(href="#")
							picture
								//- source(media="(min-width: 1170px)" srcset='Images/CMS/hero_slider_4_1170.jpg')
								//- source(media="(min-width: 768px)" srcset='Images/CMS/hero_slider_4_768.jpg')
								//- +img('Images/CMS/hero_slider_4_360.jpg', 'HYDRA 5/S')
								+img('Images/CMS/hero_slider_4.jpg', 'Alt + title')
						.hero__slider-info
							.hero__slider-title Заголовок слайда
							.hero__slider-subtitle Подзаголовок слайда
							a.btn.btn--green.hero__slider-btn(href="#") Подробнее
				//- If we need pagination
				.swiper-pagination.hero__slider-pagination.custom__slider-pagination.js-hero-pagination
				//- If we need navigation buttons
				.swiper-arrows.hero__slider-arrows
					.swiper-button-prev.swiper-button--circle.swiper-button--black.swiper-button--inner.js-hero-prev
					.swiper-button-next.swiper-button--circle.swiper-button--black.swiper-button--inner.js-hero-next