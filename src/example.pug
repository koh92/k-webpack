extends include/_layout

block variables
	- var title = "Project name | Example components"

include components/_accordion
include components/_item-example

block content

	.visually-hidden

		//- Пример ссылки на всплывающие окна
		a(data-fancybox data-src=`assets/images/CMS/hero_image.jpg`)
			+img(`Images/example/hero_image.jpg`, "")

		picture
			//- Desktop
			source(media="(min-width: 1200px)", srcset="Images/example/hero_image.jpg")
			//- Tablet
			source(media="(min-width: 744px)", srcset="Images/example/hero_image.jpg")
			//- Mobile
			+img("Images/example/hero_image.jpg")

		.container
			//- Example item component
			each cardItem, index in exampleCardData
				+item-example({name: cardItem.name, image: index})
	
		//- Accordion
		.container
			+accordion-section({title: "Тестовый аккордеон"})

		//- Dropdown
		.container
			.dropdown.js-dropdown
				.dropdown__heading.js-dropdown-heading
					.dropdown__heading-text EUR
					.dropdown__arrow
						svg(viewBox="0 0 40 40")
							use(xlink:href=Icons + "#icon_arrow_down")
				.dropdown__box
					.dropdown__content
						ul
							li
								a.dropdown__item.active(href="#") RUB
							li
								a.dropdown__item(href="#") TRY
							li
								a.dropdown__item(href="#") USD

			.dropdown.js-dropdown
				input.js-dropdown-input(type="hidden" name="calculator[laminating-type]" value="disabled")
				.dropdown__heading.js-dropdown-heading
					.dropdown__heading-text.js-dropdown-title Не требуется
					.dropdown__arrow
						svg(viewBox="0 0 16 16")
							use(xlink:href=Icons + "#icon_arrow_down")
				.dropdown__box
					.dropdown__content
						ul.dropdown__list
							li
								button.dropdown__item.js-dropdown-item.active(type="button" data-value="disabled") Не требуется
							li
								button.dropdown__item.js-dropdown-item(type="button" data-value="one_side") Одна сторона
							li
								button.dropdown__item.js-dropdown-item(type="button" data-value="two_side") Две стороны

		//- Rating 
		.container
			.rating.--small
				.rating__stars.js-rating-stars(role="radiogroup" aria-label="Рейтинг")
					- for (var i = 0; i < 5; i++)
						.rating__star.js-rating-star(
							data-count=i, 
							aria-label=`Оценка ${i+1} из 5`, 
							role="radio",
							aria-checked="false",
							tabindex="0"
						)
							svg(viewBox="0 0 24 26")
								use(xlink:href=Icons + "#icon_star")

		//- Marquee
		.container
			.marquee(style="--marquee-duration: 30s;--marquee-gap: 15px")
				ul.marquee__group(role="list")
					each name, key in exampleClientsData
						li.marquee__item.noselect= name
				ul.marquee__group(aria-hidden="true")
					each name, key in exampleClientsData
						li.marquee__item.noselect= name

		//- Password visibility toggler
		.container
			.personal__form-input.js-password-box
				input(type="password" maxlength="255" autocomplete="off")
				.personal__form-input-icon.js-password-toggler
					+img("Images/example/icon_eye.svg", "")
					+img("Images/example/icon_not_eye.svg", "")

		//- Input type range
		.container
			include components/_filter-catalog

		//- Swiper
		.container
			// Slider main container
			.swiper
				// Additional required wrapper
				.swiper-wrapper
					// Slides
					.swiper-slide
					.swiper-slide
					.swiper-slide

				// If we need pagination
				.swiper-pagination

				// If we need navigation buttons
				.swiper-button-prev
				.swiper-button-next

				// If we need scrollbar
				.swiper-scrollbar